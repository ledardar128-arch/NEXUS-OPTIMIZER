<Window x:Class="NexusOptimizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEXUS OPTIMIZER" Height="800" Width="1280" MinHeight="650" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0E101A" BorderBrush="#24263A" BorderThickness="0,0,1,0">
   <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="2,10,0,32">
      <Border Width="38" Height="38" CornerRadius="12" Background="#8D5CF6" VerticalAlignment="Center">
       <TextBlock Text="N" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="NEXUS" FontSize="20" FontWeight="Black" />
       <TextBlock Text="OPTIMIZER" FontSize="10" Foreground="{StaticResource Accent2}" FontWeight="Bold" />
      </StackPanel>
     </StackPanel>
     <TextBlock Text="ESPACE DE TRAVAIL" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,0,0,10"/>
     <Button Content="◈   Vue d'ensemble" Click="Dashboard_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⚡   Optimisation gaming" Click="Optimize_Click" HorizontalContentAlignment="Left"/>
     <Button Content="▤   Processus" Click="Processes_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⌁   Nettoyage" Click="Cleanup_Click" HorizontalContentAlignment="Left"/>
     <Button Content="⚙   Paramètres & journal" Click="Settings_Click" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,10">
     <Border Background="#17182A" BorderBrush="#302746" BorderThickness="1" CornerRadius="12" Padding="12">
      <StackPanel>
       <TextBlock Text="MODE SÉCURISÉ" FontWeight="Bold" FontSize="11" Foreground="#74E6B0"/>
       <TextBlock Text="Aucune désactivation automatique des protections Windows." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="NEXUS  •  v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="4,14,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,24">
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="Vue d'ensemble" FontSize="28" FontWeight="Bold"/>
     <TextBlock x:Name="PageSubtitle" Text="Surveillez votre système et préparez votre prochaine session." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Right" Background="#171A28" CornerRadius="16" Padding="12,8" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="#54E5A5" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="SYSTÈME EN LIGNE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="ContentPanel">
     <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,12,0">
       <StackPanel><TextBlock Text="PROCESSEUR" Foreground="{StaticResource TextMuted}" FontSize="11"/><TextBlock x:Name="CpuValue" Text="— %" FontSize="31" FontWeight="Bold" Margin="0,10,0,8"/><ProgressBar x:Name="CpuBar" Height="5" Maximum="100" Value="0" Foreground="{StaticResource Accent}"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="6,0">
       <StackPanel><TextBlock Text="MÉMOIRE VIVE" Foreground="{StaticResource TextMuted}" FontSize="11"/><TextBlock x:Name="RamValue" Text="— %" FontSize="31" FontWeight="Bold" Margin="0,10,0,8"/><ProgressBar x:Name="RamBar" Height="5" Maximum="100" Value="0" Foreground="{StaticResource Accent2}"/></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="12,0,0,0">
       <StackPanel><TextBlock Text="STOCKAGE C:" Foreground="{StaticResource TextMuted}" FontSize="11"/><TextBlock x:Name="DiskValue" Text="— %" FontSize="31" FontWeight="Bold" Margin="0,10,0,8"/><ProgressBar x:Name="DiskBar" Height="5" Maximum="100" Value="0" Foreground="#D69AFF"/></StackPanel>
      </Border>
     </Grid>
     <Border Background="#171329" BorderBrush="#403064" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,16">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="PRÊT POUR LE GAME ?" FontSize="11" Foreground="{StaticResource Accent2}" FontWeight="Bold"/>
        <TextBlock Text="Un PC entretenu, sans réglages risqués." FontSize="22" FontWeight="Bold" Margin="0,8,0,6"/>
        <TextBlock Text="Lance une vérification et choisis les actions à appliquer." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
       </StackPanel>
       <Button Grid.Column="1" Content="⚡  OPTIMISER MON PC" Padding="22,16" Background="#7548D9" Click="OptimizeNow_Click" VerticalAlignment="Center" Margin="20,0,0,0"/>
      </Grid>
     </Border>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="20" Margin="0,0,12,0">
       <StackPanel><TextBlock Text="ACTIVITÉ RÉCENTE" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="ActivityText" Text="Aucune action enregistrée pour le moment." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="16" Padding="20" Margin="6,0,0,0">
       <StackPanel><TextBlock Text="INFORMATIONS SYSTÈME" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="SystemInfoText" Text="Chargement…" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel>
      </Border>
     </Grid>
     <TextBlock x:Name="MainMessage" Text="" Foreground="{StaticResource Accent2}" Margin="2,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="2" Text="NEXUS ne promet pas de FPS garantis. Les changements sont limités, expliqués et confirmés." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,18,0,0"/>
  </Grid>
 </Grid>
</Window>
