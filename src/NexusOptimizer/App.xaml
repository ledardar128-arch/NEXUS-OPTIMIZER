<Application x:Class="NexusOptimizer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0A0B12"/>
  <SolidColorBrush x:Key="Panel" Color="#121421"/>
  <SolidColorBrush x:Key="Panel2" Color="#191C2D"/>
  <SolidColorBrush x:Key="Accent" Color="#9D6BFF"/>
  <SolidColorBrush x:Key="Accent2" Color="#4BD9FF"/>
  <SolidColorBrush x:Key="TextMain" Color="#F5F4FF"/>
  <SolidColorBrush x:Key="TextMuted" Color="#9A9CB4"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="Background" Value="#25213C"/>
   <Setter Property="BorderBrush" Value="#48406C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Margin" Value="0,4,0,4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
  </Style>
 </Application.Resources>
</Application>
